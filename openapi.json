          "document_path": {
            "description": "Authenticated API path streaming the source PDF",
            "title": "Document Path",
            "type": "string"
          },
          "recorded_book": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
