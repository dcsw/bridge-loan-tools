          "lender_type",
          "principal",
          "recorded_date",
          "maturity_date",
          "term_months",
          "bridge_score",
          "is_bridge_loan",
          "classifier_version",
          "signals",
          "geocode_status",
          "score_band"
        ],
        "title": "LoanFeatureProperties",
        "type": "object"
      },
      "Point": {
        "additionalProperties": false,
        "properties": {
          "coordinates": {
            "description": "[longitude, latitude]",
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "title": "Coordinates",
            "type": "array"
          },
          "type": {
            "const": "Point",
            "default": "Point",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "coordinates"
        ],
        "title": "Point",
        "type": "object"
      },
      "Problem": {
        "additionalProperties": false,
        "description": "RFC 7807 problem+json with a machine code and per-field errors.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "title": "Errors",
            "type": "array"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "title": "Problem",
        "type": "object"
      },
      "SourceRef": {
        "additionalProperties": false,
        "properties": {
          "doc_id": {
            "title": "Doc Id",
