          "town",
          "documents_fetched",
          "gaps",
          "last_ingested_at"
        ],
        "title": "TownCoverage",
        "type": "object"
      }
    },
    "securitySchemes": {
      "GatewayAuth": {
        "in": "header",
        "name": "X-Gateway-Secret",
        "type": "apiKey"
      },
      "KeyId": {
        "in": "header",
        "name": "X-Key-Id",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Read API over the published bridge-loan snapshot. Gateway-only.",
    "title": "Bridge Loan API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/coverage": {
      "get": {
        "operationId": "coverage_coverage_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Coverage"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Missing or invalid gateway credentials"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Snapshot or dependency unavailable (Retry-After set for snapshot outages)",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying",
                "schema": {
                  "minimum": 0,
                  "type": "integer"
                }
              }
            }
          }
        },
        "security": [
          {
            "GatewayAuth": []
          },
          {
            "KeyId": []
          }
        ],
        "summary": "Per-town ingestion coverage"
      }
    },
    "/health/live": {
      "get": {
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Process liveness",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Snapshot or dependency unavailable (Retry-After set for snapshot outages)",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying",
                "schema": {
                  "minimum": 0,
                  "type": "integer"
                }
              }
            }
          }
        },
        "summary": "Snapshot readable",
        "tags": [
          "health"
        ]
      }
    },
    "/loans": {
      "get": {
        "operationId": "list_loans_loans_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 500,
              "maximum": 2000,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 512,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          },
          {
            "description": "minLon,minLat,maxLon,maxLat (ordered, within world bounds)",
            "in": "query",
            "name": "bbox",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "minLon,minLat,maxLon,maxLat (ordered, within world bounds)",
              "title": "Bbox"
            }
          },
          {
            "in": "query",
            "name": "town",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "mattapoisett",
                    "rye",
                    "madison"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Town"
            }
          },
          {
            "in": "query",
            "name": "min_score",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 100,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Min Score"
            }
          },
          {
            "in": "query",
            "name": "lender_type",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "bank",
                    "credit_union",
                    "private_llc",
                    "individual",
                    "other",
                    "unknown"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Lender Type"
            }
          },
          {
            "description": "ISO date, inclusive",
            "in": "query",
            "name": "recorded_from",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "ISO date, inclusive",
              "title": "Recorded From"
            }
          },
          {
            "description": "ISO date, inclusive",
            "in": "query",
            "name": "recorded_to",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "ISO date, inclusive",
              "title": "Recorded To"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/geo+json": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Invalid parameters or cursor (problem+json with errors[])"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Missing or invalid gateway credentials"
          },
          "410": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
