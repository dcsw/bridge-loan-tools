{
  "components": {
    "schemas": {
      "Coverage": {
        "additionalProperties": false,
        "properties": {
          "generated_at": {
            "title": "Generated At",
            "type": "string"
          },
          "towns": {
            "items": {
              "$ref": "#/components/schemas/TownCoverage"
            },
            "title": "Towns",
            "type": "array"
          }
        },
        "required": [
          "generated_at",
          "towns"
        ],
        "title": "Coverage",
        "type": "object"
      },
      "Feature": {
        "additionalProperties": false,
        "properties": {
          "geometry": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Point"
              },
              {
                "type": "null"
              }
            ],
            "description": "null for loans that could not be geocoded"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "properties": {
            "$ref": "#/components/schemas/LoanFeatureProperties"
          },
          "type": {
            "const": "Feature",
            "default": "Feature",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "id",
          "geometry",
          "properties"
        ],
        "title": "Feature",
        "type": "object"
      },
      "FeatureCollection": {
        "additionalProperties": false,
        "properties": {
          "features": {
            "items": {
              "$ref": "#/components/schemas/Feature"
            },
            "title": "Features",
            "type": "array"
          },
          "generated_at": {
            "description": "Snapshot generation time (ISO 8601)",
            "title": "Generated At",
            "type": "string"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          },
          "total": {
            "description": "Rows matching all filters (bbox included)",
            "minimum": 0.0,
            "title": "Total",
            "type": "integer"
          },
          "type": {
            "const": "FeatureCollection",
            "default": "FeatureCollection",
            "title": "Type",
            "type": "string"
          },
          "unmapped_count": {
            "description": "Rows matching all filters except bbox that have no geometry (no_match)",
            "minimum": 0.0,
            "title": "Unmapped Count",
            "type": "integer"
          }
        },
        "required": [
          "features",
          "total",
          "unmapped_count",
          "next_cursor",
          "generated_at"
        ],
        "title": "FeatureCollection",
        "type": "object"
      },
      "FieldError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "field": {
            "title": "Field",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "field",
          "message",
          "code"
        ],
        "title": "FieldError",
        "type": "object"
      },
      "FieldValue": {
        "additionalProperties": false,
        "description": "Per-field provenance for unified values.",
        "properties": {
          "confidence": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "number"
          },
          "disagreement": {
            "default": false,
            "title": "Disagreement",
            "type": "boolean"
          },
          "source_extractor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Extractor"
          },
          "value": {
            "title": "Value"
          }
        },
        "required": [
          "confidence"
        ],
        "title": "FieldValue",
        "type": "object"
      },
      "GapCounts": {
        "additionalProperties": false,
        "properties": {
          "blocked": {
            "minimum": 0.0,
            "title": "Blocked",
            "type": "integer"
          },
          "failed": {
            "minimum": 0.0,
            "title": "Failed",
            "type": "integer"
          },
          "paid": {
            "minimum": 0.0,
            "title": "Paid",
            "type": "integer"
          }
        },
        "required": [
          "paid",
          "blocked",
          "failed"
        ],
        "title": "GapCounts",
        "type": "object"
      },
      "Health": {
        "additionalProperties": false,
        "properties": {
          "snapshot_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Snapshot Id"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "Health",
        "type": "object"
      },
      "LoanDetail": {
        "additionalProperties": false,
        "description": "GET /loans/{loan_id}: list properties plus borrower (PII), provenance and source.",
        "properties": {
          "address_norm": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
