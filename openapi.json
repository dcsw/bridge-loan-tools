            "description": "Per-field value/source_extractor/confidence/disagreement",
            "title": "Fields",
            "type": "object"
          },
          "geocode_status": {
            "enum": [
              "matched",
              "low_match",
              "no_match"
            ],
            "title": "Geocode Status",
            "type": "string"
          },
          "is_bridge_loan": {
            "title": "Is Bridge Loan",
            "type": "boolean"
          },
          "last_ingested_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Ingested At"
          },
          "lender": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lender"
          },
          "lender_type": {
            "anyOf": [
              {
                "enum": [
                  "bank",
                  "credit_union",
                  "private_llc",
                  "individual",
                  "other",
                  "unknown"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lender Type"
          },
          "loan_id": {
            "title": "Loan Id",
            "type": "string"
          },
          "maturity_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Maturity Date"
          },
          "principal": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Principal"
          },
          "recorded_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Recorded Date"
          },
          "score_band": {
            "enum": [
              "low",
              "mid",
              "high"
            ],
            "title": "Score Band",
            "type": "string"
          },
          "signals": {
            "items": {
              "enum": [
                "purchase_then_mortgage_90d",
                "second_lien",
                "short_term",
                "private_lender",
                "no_discharge",
                "keyword"
              ],
              "type": "string"
            },
            "title": "Signals",
            "type": "array"
          },
          "signals_unevaluable": {
            "items": {
              "enum": [
                "purchase_then_mortgage_90d",
                "second_lien",
                "short_term",
                "private_lender",
                "no_discharge",
                "keyword"
              ],
              "type": "string"
            },
            "title": "Signals Unevaluable",
            "type": "array"
          },
          "source": {
            "$ref": "#/components/schemas/SourceRef"
          },
          "term_months": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Term Months"
          }
        },
        "required": [
          "loan_id",
          "address_norm",
          "lender",
          "lender_type",
          "principal",
          "recorded_date",
          "maturity_date",
          "term_months",
          "bridge_score",
          "is_bridge_loan",
          "classifier_version",
          "signals",
          "geocode_status",
          "score_band",
          "borrower",
          "signals_unevaluable",
          "fields",
          "source"
        ],
        "title": "LoanDetail",
        "type": "object"
      },
      "LoanFeatureProperties": {
