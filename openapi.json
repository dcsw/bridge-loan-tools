          },
          "recorded_page": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Recorded Page"
          },
          "source_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Url"
          }
        },
        "required": [
          "doc_id",
          "recorded_book",
          "recorded_page",
          "source_url",
          "document_path"
        ],
        "title": "SourceRef",
        "type": "object"
      },
      "TownCoverage": {
        "additionalProperties": false,
        "properties": {
          "documents_fetched": {
            "minimum": 0.0,
            "title": "Documents Fetched",
            "type": "integer"
          },
          "gaps": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GapCounts"
              },
              {
                "type": "null"
              }
            ],
            "description": "null when the snapshot carries no gap data"
          },
          "last_ingested_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
